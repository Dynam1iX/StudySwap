# Copy to .env.local and fill in from Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (never NEXT_PUBLIC_): used by /api/cards to check and write cards.
# Supabase: Project Settings → API keys → service_role (secret). Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio → API keys. Without it every new card waits for a moderator.
GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-3.8-flash).
# GEMINI_MODEL=
# Optional: model asked once when the main one is overloaded (default gemini-3.5-flash-lite).
# GEMINI_FALLBACK_MODEL=
